# Firebase Admin (solo servidor). No subas claves reales.
FIREBASE_PROJECT_ID=hacklingo-nova
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hacklingo-nova.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Alternativa: todo el JSON de la cuenta de servicio en una sola variable.
# Si usas esta, puedes omitir las tres variables de arriba.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"hacklingo-nova",...}

# Opcionales
REFERRAL_IP_SALT=cambia-esta-cadena-por-una-larga-y-aleatoria
NEXT_PUBLIC_SITE_URL=https://apps-peach-two.vercel.app

# Config web de Firebase (opcional; el sistema de referidos no la usa).
# En Next.js el prefijo es NEXT_PUBLIC_, no VITE_.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
